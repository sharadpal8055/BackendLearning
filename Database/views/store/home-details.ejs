<%- include('../partials/head') %>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
<%- include('../partials/nav') %>

<main class="flex-grow max-w-6xl mx-auto px-6 py-10">

  <!-- Hero Section -->
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
<%- include('../partials/favourite'), %>
    <!-- Main Image -->
    <div class="relative">
      <img 
        src="<%= home.photoUrl %>" 
        class="w-full h-[400px] object-cover"
      />

      <!-- Rating Badge -->
      <div class="absolute top-5 right-5 bg-white px-4 py-2 rounded-full shadow-md font-semibold text-yellow-500">
       <%= home.rating %>
      </div>
    </div>

    <!-- Content -->
    <div class="p-8 space-y-6">

      <!-- Title & Location -->
      <div>
        <h1 class="text-3xl font-bold text-gray-800">
         <%= home.houseName %>
        </h1>
        <p class="text-gray-500 mt-2">
          <%= home.location %>
        </p>
      </div>

      <!-- Price + CTA -->
      <div class="flex justify-between items-center border-t pt-6">

        <div>
          <p class="text-2xl font-bold text-gray-900">
           <%= home.price %>
            <span class="text-base font-normal text-gray-500">/ night</span>
          </p>
        </div>

        <button class="bg-red-500 text-white px-8 py-3 rounded-xl text-lg hover:bg-red-600 transition shadow-md">
          Book Now
        </button>
    
   <%- include('../partials/favourite',{home:home}) %>
      </div>

    </div>

  </div>

  <!-- Description Section -->
  <div class="mt-10 bg-white rounded-2xl shadow-md p-8 space-y-4">

    <h2 class="text-2xl font-semibold text-gray-800">
      About this place
    </h2>

    <p class="text-gray-600 leading-relaxed">
      Enjoy a luxurious stay at this beautiful beachfront villa with stunning
      ocean views. The property includes modern interiors, a private pool,
      spacious bedrooms, and a fully equipped kitchen. Perfect for families
      and groups looking for a relaxing getaway.
    </p>

    <!-- Amenities -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 pt-4">

      <div class="flex items-center space-x-2 text-gray-600">
        <span>🏊</span>
        <span>Private Pool</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-600">
        <span>📶</span>
        <span>Free WiFi</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-600">
        <span>🍳</span>
        <span>Kitchen</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-600">
        <span>🚗</span>
        <span>Free Parking</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-600">
        <span>🛏️</span>
        <span>3 Bedrooms</span>
      </div>

      <div class="flex items-center space-x-2 text-gray-600">
        <span>❄️</span>
        <span>Air Conditioning</span>
      </div>

    </div>

  </div>

</main>

</body>
</html>
