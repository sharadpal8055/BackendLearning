<%- include('../partials/head') %>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

<%- include('../partials/nav') %>

<main class="flex-grow max-w-6xl mx-auto px-6 py-10">

  <!-- Page Title -->
  <h1 class="text-3xl font-bold text-gray-800 mb-8">
    My Bookings
  </h1>

  <!-- Dummy Booking List -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    <!-- Booking Card 1 -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
      <img src="https://picsum.photos/400/250?random=1"
           class="w-full h-48 object-cover" />
      <div class="p-5 space-y-2">
        <h2 class="text-xl font-semibold text-gray-800">
          Beachside Villa
        </h2>
        <p class="text-gray-600">Location: Goa</p>
        <p class="text-gray-600">₹ 4500 / night</p>
        <p class="text-yellow-500">⭐ 4.5</p>
        <button class="mt-3 w-full bg-red-500 text-white py-2 rounded-lg hover:bg-red-600 transition">
          Cancel Booking
        </button>
      </div>
    </div>

    <!-- Booking Card 2 -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
      <img src="https://picsum.photos/400/250?random=2"
           class="w-full h-48 object-cover" />
      <div class="p-5 space-y-2">
        <h2 class="text-xl font-semibold text-gray-800">
          Mountain Retreat
        </h2>
        <p class="text-gray-600">Location: Manali</p>
        <p class="text-gray-600">₹ 3200 / night</p>
        <p class="text-yellow-500">⭐ 4.2</p>
        <button class="mt-3 w-full bg-red-500 text-white py-2 rounded-lg hover:bg-red-600 transition">
          Cancel Booking
        </button>
      </div>
    </div>

    <!-- Booking Card 3 -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
      <img src="https://picsum.photos/400/250?random=3"
           class="w-full h-48 object-cover" />
      <div class="p-5 space-y-2">
        <h2 class="text-xl font-semibold text-gray-800">
          City Apartment
        </h2>
        <p class="text-gray-600">Location: Mumbai</p>
        <p class="text-gray-600">₹ 2800 / night</p>
        <p class="text-yellow-500">⭐ 4.0</p>
        <button class="mt-3 w-full bg-red-500 text-white py-2 rounded-lg hover:bg-red-600 transition">
          Cancel Booking
        </button>
      </div>
    </div>

  </div>

</main>

</body>
</html>
